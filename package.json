{
  "name": "vertex-management-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Vertex Management API - students, fees, payments, teacher commissions",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/prisma.mjs generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:push": "node scripts/prisma.mjs db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "cross-env SEED_DEMO_DATA=true tsx prisma/seed.ts",
    "db:studio": "node scripts/prisma.mjs studio",
    "db:setup": "node scripts/prisma.mjs migrate deploy && tsx prisma/seed.ts",
    "postinstall": "node scripts/prisma.mjs generate",
    "vercel-build": "node scripts/prisma.mjs generate && node scripts/prisma.mjs migrate deploy && tsx prisma/seed.ts",
    "db:status": "node scripts/prisma.mjs migrate status"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
