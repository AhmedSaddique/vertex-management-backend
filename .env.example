# PostgreSQL connection string.
# Local:  postgresql://postgres:PASSWORD@localhost:5432/vertexmanagement?schema=public
# Vercel: use a hosted Postgres (Neon, Supabase, Vercel Postgres). Prefer the pooled connection
#         string for serverless; add ?pgbouncer=true for Supabase pooler.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/vertexmanagement?schema=public"

# Server (ignored on Vercel)
PORT=5000
NODE_ENV=development

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Frontend origins allowed to call this API (comma separated, * wildcards allowed).
# Defaults to the local frontend plus https://vertexmanagement.vercel.app
CORS_ORIGIN="http://localhost:3000,https://vertexmanagement.vercel.app,https://vertex-management-frontend-*.vercel.app"

# Seed accounts (used by `npm run db:seed`)
SEED_ADMIN_NAME="Ahmad"
SEED_ADMIN_EMAIL="admin@vertex.com"
SEED_ADMIN_PASSWORD="admin123"
SEED_TEACHER_PASSWORD="teacher123"
SEED_DEMO_DATA=false

# ----- Email notifications -----
# Sent to the student and to NOTIFY_EMAILS when a student enrolls and on every payment.
# Leave SMTP_* empty to turn email off: records are still saved, nothing is sent.
# Gmail: turn on 2-step verification, create an App Password (16 characters) and use it
# as SMTP_PASS. Your normal Gmail password will not work.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="ahmed.saddique12@gmail.com"
SMTP_PASS=""
MAIL_FROM="Vertex Trading Academy <ahmed.saddique12@gmail.com>"
# Optional: where replies should go
MAIL_REPLY_TO=""
# Everyone who gets the team copy, comma separated
NOTIFY_EMAILS="ahmed.saddique12@gmail.com"
# Currency shown in emails, and the link used in the team copy
CURRENCY="Rs"
APP_URL="https://vertexmanagement.vercel.app"
# Set to "json" to build emails without delivering them (local testing)
MAIL_DRIVER="smtp"
