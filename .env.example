# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/vertex_management?schema=public"

# Server
PORT=5000
NODE_ENV=development

# Auth - change this to a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Comma separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:3000"

# Seed accounts (used by `npm run db:seed`)
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@vertex.com"
SEED_ADMIN_PASSWORD="admin123"
SEED_TEACHER_PASSWORD="teacher123"
# Set to true to also insert demo students & payments
SEED_DEMO_DATA=false
